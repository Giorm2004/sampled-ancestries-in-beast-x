<?xml version="1.0" standalone="yes"?>
<beast>
    <!-- Sampled-ancestor operators (dr.evomodel.operators.sa, ports of BEAST 2's SA package) under the prior of the
         episodic birth-death sampling model with sampled ancestors: 14 taxa (6 ancient, ages uniform on +-0.2 kyr),
         BDSKY window parameters fixed, origin uniform on [9, 12]. Against BEAST 2 (BDSKY 1.5.1 + SA 2.1.1, the same
         model and operator mix; 2e7 steps each, 10% burn-in) the distributions agree: mean number of sampled
         ancestors 2.044 (BEAST 2) vs 2.056, root height 4.222 vs 4.210, tree length 13.61 vs 13.62, origin 9.86 vs
         9.85, all six tip ages within 1.1 standard errors, KS p >= 0.17. Structural invariants are checked by
         test.dr.evomodel.operators.SampledAncestorOperatorTest. -->
    <taxa id="taxa">
        <taxon id="m0"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m1"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m2"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m3"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m4"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m5"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m6"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="m7"><date value="0.0" direction="backwards" units="years"/></taxon>
        <taxon id="a0"><date value="0.3" direction="backwards" units="years"/></taxon>
        <taxon id="a1"><date value="0.9" direction="backwards" units="years"/></taxon>
        <taxon id="a2"><date value="1.5" direction="backwards" units="years"/></taxon>
        <taxon id="a3"><date value="2.2" direction="backwards" units="years"/></taxon>
        <taxon id="a4"><date value="3.0" direction="backwards" units="years"/></taxon>
        <taxon id="a5"><date value="3.45" direction="backwards" units="years"/></taxon>
    </taxa>
    <newick id="tree0" usingDates="true">(a2:6.357000000000,((m2:6.369000000000,(a0:5.203000000000,(m5:4.374000000000,(a3:1.544000000000,a4:0.744000000000):0.630000000000):1.129000000000):0.866000000000):0.647000000000,((m6:5.433000000000,(a1:3.726000000000,a5:1.176000000000):0.807000000000):1.159000000000,(m0:2.691000000000,((m3:0.375000000000,m4:0.375000000000):1.618000000000,(m1:1.184000000000,m7:1.184000000000):0.809000000000):0.698000000000):3.901000000000):0.424000000000):0.841000000000);</newick>
    <treeModel id="treeModel"><newick idref="tree0"/>
        <rootHeight><parameter id="treeModel.rootHeight"/></rootHeight>
        <nodeHeights internalNodes="true"><parameter id="treeModel.internalNodeHeights"/></nodeHeights>
        <leafHeight taxon="a0"><parameter id="age.a0"/></leafHeight>
        <leafHeight taxon="a1"><parameter id="age.a1"/></leafHeight>
        <leafHeight taxon="a2"><parameter id="age.a2"/></leafHeight>
        <leafHeight taxon="a3"><parameter id="age.a3"/></leafHeight>
        <leafHeight taxon="a4"><parameter id="age.a4"/></leafHeight>
        <leafHeight taxon="a5"><parameter id="age.a5"/></leafHeight>
    </treeModel>
    <episodicBirthDeathSamplingModel id="bdsky" units="years" conditionOnSurvival="true" sampledAncestors="true">
        <reproductiveNumber><parameter value="1.5"/></reproductiveNumber>
        <becomeUninfectiousRate><parameter value="2.0"/></becomeUninfectiousRate>
        <samplingProportion><parameter value="0.0 0.1 0.0"/></samplingProportion>
        <treatmentProbability><parameter value="0.0 0.0 0.0"/></treatmentProbability>
        <samplingProbability><parameter value="0.2 0.0 0.0"/></samplingProbability>
        <origin><parameter id="origin" value="9.2"/></origin>
        <breakPoints><parameter value="0.02 4.401"/></breakPoints>
    </episodicBirthDeathSamplingModel>
    <birthDeathLikelihood id="bd" useNewLoop="true"><model><episodicBirthDeathSamplingModel idref="bdsky"/></model>
        <tree><treeModel idref="treeModel"/></tree></birthDeathLikelihood>
    <sampledAncestorCount id="SA" name="sampledAncestors"><treeModel idref="treeModel"/></sampledAncestorCount>
    <treeLengthStatistic id="length"><treeModel idref="treeModel"/></treeLengthStatistic>
    <operators id="operators">
        <saScaleOperator scaleFactor="0.9" weight="6.0"><treeModel idref="treeModel"/></saScaleOperator>
        <saScaleOperator scaleFactor="0.8" rootOnly="true" weight="6.0"><treeModel idref="treeModel"/></saScaleOperator>
        <saUniformNodeHeight weight="60.0"><treeModel idref="treeModel"/></saUniformNodeHeight>
        <saExchange isNarrow="true" weight="30.0"><treeModel idref="treeModel"/></saExchange>
        <saExchange isNarrow="false" weight="10.0"><treeModel idref="treeModel"/></saExchange>
        <saWilsonBalding weight="10.0"><treeModel idref="treeModel"/></saWilsonBalding>
        <saLeafToSampledAncestorJump weight="10.0"><treeModel idref="treeModel"/></saLeafToSampledAncestorJump>
        <saTipDateRandomWalker windowSize="0.05" useGaussian="true" weight="1.0"><treeModel idref="treeModel"/><taxa><taxon idref="a0"/></taxa></saTipDateRandomWalker>
        <saTipDateRandomWalker windowSize="0.05" useGaussian="true" weight="1.0"><treeModel idref="treeModel"/><taxa><taxon idref="a1"/></taxa></saTipDateRandomWalker>
        <saTipDateRandomWalker windowSize="0.05" useGaussian="true" weight="1.0"><treeModel idref="treeModel"/><taxa><taxon idref="a2"/></taxa></saTipDateRandomWalker>
        <saTipDateRandomWalker windowSize="0.05" useGaussian="true" weight="1.0"><treeModel idref="treeModel"/><taxa><taxon idref="a3"/></taxa></saTipDateRandomWalker>
        <saTipDateRandomWalker windowSize="0.05" useGaussian="true" weight="1.0"><treeModel idref="treeModel"/><taxa><taxon idref="a4"/></taxa></saTipDateRandomWalker>
        <saTipDateRandomWalker windowSize="0.05" useGaussian="true" weight="1.0"><treeModel idref="treeModel"/><taxa><taxon idref="a5"/></taxa></saTipDateRandomWalker>
        <saUpDownOperator scaleFactor="0.85" weight="20.0"><up><treeModel idref="treeModel"/><parameter idref="origin"/></up></saUpDownOperator>
    </operators>
    <mcmc id="mcmc" chainLength="20000000" autoOptimize="false">
        <posterior id="posterior"><prior id="prior"><birthDeathLikelihood idref="bd"/><uniformPrior lower="0.1000" upper="0.5000"><parameter idref="age.a0"/></uniformPrior><uniformPrior lower="0.7000" upper="1.1000"><parameter idref="age.a1"/></uniformPrior><uniformPrior lower="1.3000" upper="1.7000"><parameter idref="age.a2"/></uniformPrior><uniformPrior lower="2.0000" upper="2.4000"><parameter idref="age.a3"/></uniformPrior><uniformPrior lower="2.8000" upper="3.2000"><parameter idref="age.a4"/></uniformPrior><uniformPrior lower="3.2500" upper="3.6500"><parameter idref="age.a5"/></uniformPrior><uniformPrior lower="9.0" upper="12.0"><parameter idref="origin"/></uniformPrior></prior></posterior>
        <operators idref="operators"/>
        <log id="fileLog" logEvery="2000" fileName="testSampledAncestorOperators.log" overwrite="true">
            <posterior idref="posterior"/><sampledAncestorCount idref="SA"/>
            <parameter idref="treeModel.rootHeight"/><treeLengthStatistic idref="length"/><parameter idref="origin"/><parameter idref="age.a0"/><parameter idref="age.a1"/><parameter idref="age.a2"/><parameter idref="age.a3"/><parameter idref="age.a4"/><parameter idref="age.a5"/>
        </log>
    </mcmc>
</beast>
