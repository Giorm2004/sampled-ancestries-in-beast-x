    <alignment id="alignment1" dataType="twoStateCovarion">
        <sequence><taxon idref="t0"/>00111101010001001100011000</sequence>
        <sequence><taxon idref="t1"/>00000100110010001100010111</sequence>
        <sequence><taxon idref="t2"/>01000000100010111011001001</sequence>
