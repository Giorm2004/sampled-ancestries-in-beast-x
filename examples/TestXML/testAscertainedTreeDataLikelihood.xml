    <branchRateGradient id="rateGradient1" traitName="covarion"><treeDataLikelihood idref="tdl1"/></branchRateGradient>
    <nodeHeightGradient id="heightGradient1" traitName="covarion"><treeDataLikelihood idref="tdl1"/></nodeHeightGradient>
    <treeDataLikelihood id="tdl2" useAmbiguities="true" usePreOrder="true" scalingScheme="always">
