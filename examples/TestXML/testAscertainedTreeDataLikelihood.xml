    <branchRateGradient id="rateGradient2" traitName="covarion"><treeDataLikelihood idref="tdl2"/></branchRateGradient>
    <nodeHeightGradient id="heightGradient2" traitName="covarion"><treeDataLikelihood idref="tdl2"/></nodeHeightGradient>
</beast>
