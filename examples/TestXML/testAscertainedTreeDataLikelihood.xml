        <sequence><taxon idref="t4"/>0010000100000100100100101010000</sequence>
        <sequence><taxon idref="t5"/>0100001000011011000100010010000</sequence>
        <sequence><taxon idref="t6"/>0010100100011001001101100110101</sequence>
        <sequence><taxon idref="t7"/>0000000101011011001111110001000</sequence>
        <sequence><taxon idref="t8"/>0000000101001001001110000110001</sequence>
        <sequence><taxon idref="t9"/>???????????????????????????????</sequence>
        <sequence><taxon idref="t10"/>0000010010000000010010000100011</sequence>
        <sequence><taxon idref="t11"/>0010001111100001011010101001011</sequence>
