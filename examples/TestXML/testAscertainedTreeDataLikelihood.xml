    <newick id="startingTree" usingDates="true">(t7:6.780744,(t2:6.674852,((t9:1.502064,(t6:2.722706,(t4:1.661010,(t5:1.292304,t8:0.392304):0.368706):1.061696):0.379358):2.913531,((t1:4.181948,t11:0.981948):0.913798,(t3:3.974546,(t0:3.108449,t10:1.008449):0.866097):1.121200):0.919849):0.659257):0.505892);</newick>
    <treeModel id="treeModel">
        <newick idref="startingTree"/>
        <rootHeight><parameter id="treeModel.rootHeight"/></rootHeight>
        <nodeHeights internalNodes="true"><parameter id="treeModel.internalNodeHeights"/></nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true"><parameter id="treeModel.allInternalNodeHeights"/></nodeHeights>
    </treeModel>
    <arbitraryBranchRates id="branchRates" centerAtOne="false">
        <rates><parameter id="clock.rates" value="1.0" lower="0"/></rates>
        <scale><parameter id="clock.rates.scale" value="1.0" lower="0"/></scale>
        <location><parameter id="clock.rates.location" value="0.35" lower="0"/></location>
        <treeModel idref="treeModel"/>
    </arbitraryBranchRates>
    <binaryCovarionModel id="covarion" version="1">
        <frequencies><parameter id="covarion.frequencies" value="0.7 0.3"/></frequencies>
        <hiddenFrequencies><parameter id="covarion.hiddenFrequencies" value="0.6 0.4"/></hiddenFrequencies>
        <alpha><parameter id="covarion.alpha" value="0.25"/></alpha>
        <switchingRate><parameter id="covarion.switchingRate" value="0.8"/></switchingRate>
    </binaryCovarionModel>
    <siteModel id="siteModel1"><substitutionModel><binaryCovarionModel idref="covarion"/></substitutionModel>
        <mutationRate><parameter id="mu1" value="1.3"/></mutationRate></siteModel>
    <siteModel id="siteModel2"><substitutionModel><binaryCovarionModel idref="covarion"/></substitutionModel>
        <mutationRate><parameter id="mu2" value="0.7"/></mutationRate>
        <gammaShape gammaCategories="4"><parameter id="alpha2" value="0.6"/></gammaShape></siteModel>
    <treeDataLikelihood id="tdl1" useAmbiguities="true" usePreOrder="true" scalingScheme="always">
        <patterns idref="patterns1"/>
        <treeModel idref="treeModel"/>
        <siteModel idref="siteModel1"/>
        <arbitraryBranchRates idref="branchRates"/>
    </treeDataLikelihood>
    <treeLikelihood id="old1" useAmbiguities="true">
        <patterns idref="patterns1"/>
        <treeModel idref="treeModel"/>
        <siteModel idref="siteModel1"/>
        <arbitraryBranchRates idref="branchRates"/>
    </treeLikelihood>
    <report>partition 1: TreeDataLikelihood ln L = <treeDataLikelihood idref="tdl1"/>
