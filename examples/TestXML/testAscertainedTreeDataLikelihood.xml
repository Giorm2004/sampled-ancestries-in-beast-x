         that is conditioned out (excludePatterns), as for per-meaning cognate data.
         Checked by test.dr.evomodel.treedatalikelihood.AscertainedTreeDataLikelihoodTest. -->
    <taxa id="taxa">
        <taxon id="t0"><date value="0" direction="backwards" units="years"/></taxon>
