            <birthDeathLikelihoodGradient idref="grad1"/>
            <nodeHeightProxyParameter idref="heights"/>
            <saNodeHeightTransform idref="saTransform"/>
        </hamiltonianMonteCarloOperator>
    </operators>
</beast>
